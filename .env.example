# Turso (libSQL) database — create a free database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Random secret used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-string

# Vercel Blob (file storage for photos/videos). If you deploy on Vercel and
# connect a Blob store to the project, this is set automatically — you only
# need to set it yourself for local development.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Comma-separated list of email addresses allowed to access /admin.
# Use the same email you sign up with in the app.
ADMIN_EMAILS=you@example.com

# Google sign-in (optional). Create these at console.cloud.google.com —
# see README.md for the exact steps. Leave blank to disable the
# "Continue with Google" button; email/password sign-in still works either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
